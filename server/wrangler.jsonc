// Cloudflare Worker for the Co-Op-Pixel-Dungeon inn, matchmaking and party relay.
// Deploy: `npm run deploy` after `node ../scripts/stage-web-client.mjs` has filled ./public.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "co-op-pixel-dungeon",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "assets": {
    // Staged web lobby and TeaVM runtime (generated, not in Git). Requests matching a file are
    // served without invoking the Worker; everything else reaches src/index.ts.
    "directory": "./public",
    // No trailing-slash rewriting: /play/original/runtime/<v>/index.html must answer 200, not 307, or
    // the runtime cache worker (redirect: 'error') cannot store it. /play/ is mapped in _redirects.
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      { "name": "INN", "class_name": "InnRoom" },
      { "name": "LINK", "class_name": "PartyLink" }
    ]
  },
  // SQLite-backed classes are the only kind available on the Workers Free plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["InnRoom", "PartyLink"] }
  ],
  "vars": {
    // Comma-separated browser origins allowed besides the Worker's own (e.g. a local preview).
    "ALLOWED_ORIGINS": ""
  },
  // Workers Logs would keep request metadata (headers, client addresses); the server stores no
  // personal data, so logging stays off. Enable temporarily when debugging a deploy.
  "observability": { "enabled": false }
}
